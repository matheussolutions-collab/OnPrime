# Configuração para hospedagem Apache (HostGator) — OnPrime

# Página inicial
DirectoryIndex index.html

# Acentos corretos no llms.txt
AddCharset UTF-8 .txt

# Compressão: arquivos de texto chegam menores
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript text/javascript image/svg+xml application/json
</IfModule>

# Cache no navegador do visitante
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
</IfModule>

# Bloqueia acesso a arquivos internos do projeto
<FilesMatch "^(LEIA-ME\.md|skills-lock\.json|\.DS_Store)$">
  Require all denied
</FilesMatch>

# HTTPS obrigatório: tire o "#" das 3 linhas abaixo DEPOIS que o SSL do domínio estiver ativo no cPanel
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
